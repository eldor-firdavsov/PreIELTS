# Client-side Supabase configuration. Both values are safe in the browser:
# the publishable key only ever acts through Row Level Security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only. Never prefixed with VITE_, never imported by src/.
# Used by scripts/upload-audio.ts and scripts/seed.ts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
